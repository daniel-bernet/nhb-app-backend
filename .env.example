# Copy to .env and adjust to your PostgreSQL instance.
# server.js and sequelize-cli use the DEV_* values (NODE_ENV=development).
DEV_DB_HOST=localhost
DEV_DB_USER=postgres
DEV_DB_PASS=change-me
DEV_DB_NAME=nhb-app
DEV_DB_PORT=5432

DEV_BACKEND_PORT=9001

# Any long random string, e.g. the output of: openssl rand -hex 32
JWT_SECRET=change-me
